#!/usr/bin/env node

const fs = require('fs');
const path = require('path');

// Forbidden env vars that indicate real API authentication
const FORBIDDEN_VARS = [
  'ANTHROPIC_API_KEY',
  'ANTHROPIC_AUTH_TOKEN',
  'CLAUDE_CODE_USE_BEDROCK',
  'CLAUDE_CODE_USE_VERTEX',
  'CLAUDE_CODE_USE_FOUNDRY'
];

// Check for forbidden env vars FIRST, before anything else
function checkForbiddenEnvVars() {
  const presentVars = FORBIDDEN_VARS.filter(v => process.env[v]);
  if (presentVars.length > 0) {
    const errorObj = {
      error: 'api_key_authentication_detected',
      message: 'Refusing to run: API-key/gateway environment variable(s) present. This mock mirrors real claude CLI precedence — subscription auth must be used exclusively.'
    };
    console.error(JSON.stringify(errorObj));
    process.exit(1);
  }
}

// Append a log line to the log file
function appendLog(logData) {
  const logPath = process.env.MOCK_CLAUDE_LOG;
  if (!logPath) return; // Skip if not set

  try {
    const line = JSON.stringify(logData) + '\n';
    fs.appendFileSync(logPath, line, 'utf8');
  } catch (e) {
    // Silently fail on logging errors (test harness issue, not our fault)
  }
}

// Parse command line arguments
function parseArgs(argv) {
  const parsed = {
    p: null,
    sessionId: null,
    model: null,
    effort: null,
    permissionMode: null,
    tools: null,
    appendSystemPromptFile: null,
    addDir: null,
    outputFormat: null,
    maxTurns: null,
    verbose: false,
    subcommand: null
  };

  let i = 0;
  while (i < argv.length) {
    const arg = argv[i];

    if (arg === '-p') {
      parsed.p = argv[++i];
    } else if (arg === '--session-id') {
      parsed.sessionId = argv[++i];
    } else if (arg === '--model') {
      parsed.model = argv[++i];
    } else if (arg === '--effort') {
      parsed.effort = argv[++i];
    } else if (arg === '--permission-mode') {
      parsed.permissionMode = argv[++i];
    } else if (arg === '--tools') {
      parsed.tools = argv[++i];
    } else if (arg === '--append-system-prompt-file') {
      parsed.appendSystemPromptFile = argv[++i];
    } else if (arg === '--add-dir') {
      parsed.addDir = argv[++i];
    } else if (arg === '--output-format') {
      parsed.outputFormat = argv[++i];
    } else if (arg === '--max-turns') {
      parsed.maxTurns = argv[++i];
    } else if (arg === '--verbose') {
      parsed.verbose = true;
    } else if (!arg.startsWith('-')) {
      // Subcommand (e.g., 'auth')
      if (!parsed.subcommand) {
        parsed.subcommand = arg;
      }
    }

    i++;
  }

  return parsed;
}

// Sleep function using busy-wait with Date.now()
function sleepSync(ms) {
  const end = Date.now() + ms;
  while (Date.now() < end) {
    // Busy wait
  }
}

// Load scenario JSON from file or return default
function loadScenario() {
  const scenarioPath = process.env.MOCK_CLAUDE_SCENARIO;
  if (!scenarioPath) {
    return {
      mode: 'plan_valid',
      plan_markdown: '# Implementation Plan\n\n## 1. Summary\n\nMock plan.\n'
    };
  }

  try {
    const content = fs.readFileSync(scenarioPath, 'utf8');
    return JSON.parse(content);
  } catch (e) {
    // Fall back to default if file can't be read
    return {
      mode: 'plan_valid',
      plan_markdown: '# Implementation Plan\n\n## 1. Summary\n\nMock plan.\n'
    };
  }
}

// Main logic
function main() {
  checkForbiddenEnvVars();

  const argv = process.argv.slice(2);
  const parsed = parseArgs(argv);

  // Log the invocation
  const logData = {
    timestamp: new Date().toISOString(),
    argv: argv,
    cwd: process.cwd(),
    env_snapshot: {
      CLAUDE_CODE_OAUTH_TOKEN: !!process.env.CLAUDE_CODE_OAUTH_TOKEN
    },
    parsed: {
      model: parsed.model,
      effort: parsed.effort,
      permission_mode: parsed.permissionMode,
      output_format: parsed.outputFormat,
      session_id: parsed.sessionId,
      max_turns: parsed.maxTurns
    }
  };

  // Handle 'auth status' subcommand
  if (parsed.subcommand === 'auth' && argv[argv.indexOf(parsed.subcommand) + 1] === 'status') {
    appendLog(logData);

    if (process.env.CLAUDE_CODE_OAUTH_TOKEN) {
      const result = {
        authenticated: true,
        method: 'subscription',
        account: 'mock-operator'
      };
      console.log(JSON.stringify(result));
      process.exit(0);
    } else {
      const result = {
        authenticated: false,
        method: null
      };
      console.log(JSON.stringify(result));
      process.exit(1);
    }
  }

  // Main invocation (planning/execution)
  const scenario = loadScenario();

  // Check session_id_expected
  if (scenario.session_id_expected && scenario.session_id_expected !== parsed.sessionId) {
    appendLog(logData);
    console.error(JSON.stringify({ error: 'session_id_mismatch' }));
    process.exit(3);
  }

  // Handle different modes
  if (scenario.mode === 'plan_valid') {
    appendLog(logData);
    if (parsed.outputFormat === 'json' || !parsed.outputFormat) {
      const result = {
        type: 'result',
        subtype: 'success',
        result: scenario.plan_markdown,
        session_id: parsed.sessionId || 'generated-session-id',
        exit_code: 0
      };
      console.log(JSON.stringify(result));
      process.exit(0);
    }
  } else if (scenario.mode === 'plan_invalid') {
    appendLog(logData);
    if (parsed.outputFormat === 'json' || !parsed.outputFormat) {
      const result = {
        type: 'result',
        subtype: 'success',
        result: scenario.invalid_plan_text,
        session_id: parsed.sessionId || 'generated-session-id',
        exit_code: 0
      };
      console.log(JSON.stringify(result));
      process.exit(0);
    }
  } else if (scenario.mode === 'invalid_model_combo') {
    appendLog(logData);
    const error = {
      error: 'unsupported_model_reasoning_combination',
      model: parsed.model,
      effort: parsed.effort
    };
    console.error(JSON.stringify(error));
    process.exit(2);
  } else if (scenario.mode === 'timeout') {
    appendLog(logData);
    if (parsed.outputFormat === 'stream-json') {
      const eventsToEmit = (scenario.events || []).slice(0, scenario.timeout_after_events || 2);
      for (const event of eventsToEmit) {
        console.log(JSON.stringify(event));
        sleepSync(50);
      }
      process.exit(124);
    } else {
      // json format
      console.error(JSON.stringify({ error: 'timeout' }));
      process.exit(124);
    }
  } else if (scenario.mode === 'exec_stream') {
    appendLog(logData);
    if (parsed.outputFormat === 'stream-json') {
      const events = scenario.events || [];
      for (const event of events) {
        console.log(JSON.stringify(event));
      }
      process.exit(scenario.exit_code || 0);
    } else {
      // Fall back to plan_valid-like behavior for json format
      const result = {
        type: 'result',
        subtype: 'success',
        result: 'Execution complete',
        session_id: parsed.sessionId || 'generated-session-id',
        exit_code: scenario.exit_code || 0
      };
      console.log(JSON.stringify(result));
      process.exit(scenario.exit_code || 0);
    }
  }

  // Default fallback
  appendLog(logData);
  const result = {
    type: 'result',
    subtype: 'success',
    result: scenario.plan_markdown || '# Default Plan\n\nNo scenario provided.',
    session_id: parsed.sessionId || 'generated-session-id',
    exit_code: 0
  };
  console.log(JSON.stringify(result));
  process.exit(0);
}

main();
